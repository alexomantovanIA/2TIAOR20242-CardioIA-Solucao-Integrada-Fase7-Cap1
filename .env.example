FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000
CORS_ORIGINS=*
DEFAULT_PATIENT_AGE=55

# Watson Assistant opcional. Deixe vazio para usar fallback local.
WATSON_API_KEY=
WATSON_URL=
WATSON_ASSISTANT_ID=
WATSON_ASSISTANT_VERSION=2021-11-27

# Fase 6/7 — OpenAI Agents opcional. Sem chave, o backend usa ml_only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Apps
VITE_API_BASE_URL=http://localhost:5000
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# Docker + LocalStack (S3) — opcional
# Quando AWS_ENDPOINT_URL aponta para LocalStack ou AWS, os logs de predição
# são copiados para o bucket após gravação local em agents/logs/.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
CARDIOIA_S3_LOG_BUCKET=cardioia-logs
